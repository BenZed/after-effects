{
  "compilerOptions": {
    // the library itself runs in node; transpilation of user scripts to es3
    // for the ExtendScript engine is handled by babel at runtime, not here.
    // no "type": "module" in package.json, so this emits commonjs.
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
